data/*
!data/probe_trajectories/
data/probe_trajectories/*
!data/probe_trajectories/lab_insertion_001.csv
outputs/
/quadrant_n5/
reports/
external/
analysis/**/outputs/
logs/

# Paper / Overleaf tree (outdated locally; leave history alone)
docs/overleaf/

# Binary / array / secret-ish artifacts
*.npy
*.npz
*.parquet
*.h5
*.nwb
*.mat
*.pkl
.env
*.pem
*.pdf
*.zip

# Explicit fixture allowlist (tracked small CSVs)
!configs/trajectories/*_regions.csv
!data/probe_trajectories/lab_insertion_001.csv
