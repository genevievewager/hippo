# Virtualenvs
.hippo/
.venv/
venv/
env/

# Bytecode / notebooks / OS junk
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
.DS_Store

# Local data and run outputs (never commit)
